# Generate a unique secret; never commit your real .env file.
DROPZONE_API_KEY=replace-with-a-long-random-secret
# Optional: absolute path to SQLite database
# DROPZONE_DB_PATH=/var/lib/dropzone/dropzone.db
# Optional real AI model via OpenAI-compatible Chat Completions API.
# Leave unset to use the explicit deterministic rules fallback.
# OPENAI_API_KEY=your-provider-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# Optional separate model for independent evidence review (Agent 2).
# DROPZONE_REVIEWER_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_SECONDS=20

# Preferred role-based keys (JSON object mapping API key to user and role).
# Roles: admin, analyst, reviewer, viewer. Use distinct long random keys.
# DROPZONE_API_KEYS={"admin-secret":{"username":"security-admin","role":"admin"},"analyst-secret":{"username":"analyst-1","role":"analyst"},"reviewer-secret":{"username":"reviewer-1","role":"reviewer"},"viewer-secret":{"username":"auditor-1","role":"viewer"}}
